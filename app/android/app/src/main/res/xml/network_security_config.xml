<?xml version="1.0" encoding="utf-8"?>
<!-- Cleartext is permitted at the OS level; BaseUrlPolicy (Dart) is the real gate
     (spec section 6). Applies to API 24+ and overrides usesCleartextTraffic. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
